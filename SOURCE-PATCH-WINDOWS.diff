+#[test]
+#[ignore = "needs an NVIDIA GPU"]
+fn two_gathered_batches_in_flight_match_the_cpu_and_keep_their_order() {
+    let p = Params {
+        m: 64,
+        k: 1024,
+        nb: 256,
+        num_blocks: 8,
+    };
+    let g = Gpu::new(0).expect("a GPU");
+    let epoch_seed = mh::epoch_seed(7);
+    let cpu = Dataset::build(&p, &epoch_seed, p.num_blocks, 6).unwrap();
+    let dev = g.build_dataset(&p, &epoch_seed, p.num_blocks).unwrap();
+    let batch = 17;
+    let mut engine = GatherEngine::new_fused(&g, &dev, batch).unwrap();
+    let header = [0xa5; 32];
+
+    // Deterministic, widely separated nonces, including wraparound. This catches slot/order/batch-boundary mistakes
+    // without adding a random-number dependency to the GPU crate.
+    let mut state = 0x9e37_79b9_7f4a_7c15u64;
+    let mut nonces = Vec::new();
+    for _ in 0..(batch * 5 + 3) {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        nonces.push(state);
+    }
+    nonces.extend([u64::MAX - 1, u64::MAX, 0, 1]);
+
+    let mut submitted = 0;
+    let mut collected = 0;
+    while collected < nonces.len() {
+        while engine.in_flight() < 2 && submitted < nonces.len() {
+            let end = (submitted + batch).min(nonces.len());
+            let seeds = nonces[submitted..end]
+                .iter()
+                .map(|&nonce| mh::attempt_seed(&header, nonce))
+                .collect();
+            engine.submit(seeds, false).unwrap();
+            submitted = end;
+        }
+        let got = engine.collect().unwrap().expect("a queued batch");
+        for attempt in got {
+            let nonce = nonces[collected];
+            let want = mh::compute_gathered_attempt(&cpu, &header, nonce).unwrap();
+            assert_eq!(
+                attempt, want,
+                "pipeline position {collected}, nonce {nonce}"
+            );
+            collected += 1;
+        }
+    }
+    assert_eq!(engine.in_flight(), 0);
+    assert!(engine.collect().unwrap().is_none());
+}
