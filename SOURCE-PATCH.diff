+impl Backend for MultiGpuBackend {
+    fn name(&self) -> String {
+        self.name.clone()
+    }
+
+    fn mine(&mut self, job: &Job, counters: &Counters) -> Result<Option<Solution>, String> {
+        const SEGMENT: u64 = 1u64 << 56;
+        let base = job.first_nonce();
+
+        for (slot, w) in self.workers.iter().enumerate() {
+            let mut sub = job.clone();
+            sub.nonce_start = Some(base.wrapping_add((slot as u64).wrapping_mul(SEGMENT)));
+            w.tx.send(MultiGpuCommand::Mine(sub))
+                .map_err(|_| format!("GPU worker {slot} stopped"))?;
+        }
+
+        let mut active = self.workers.len();
+        let mut solution = None;
+
+        while active != 0 {
+            let mut failed = None;
+            for w in &mut self.workers {
+                while let Ok(msg) = w.rx.try_recv() {
+                    match msg {
+                        MultiGpuMessage::Ready(_) => {}
+                        MultiGpuMessage::Solved(sol) => {
+                            if solution.is_none() {
+                                solution = Some(sol);
+                                job.stale.store(true, Ordering::SeqCst);
+                            }
+                        }
+                        MultiGpuMessage::Finished(id) if id == job.id => {
+                            active = active.saturating_sub(1);
+                        }
+                        MultiGpuMessage::Finished(_) => {}
+                        MultiGpuMessage::Failed(e) => {
+                            failed = Some(e);
+                            break;
+                        }
+                    }
+                }
+                if failed.is_some() {
+                    break;
+                }
+            }
+
+            self.sync_counters(counters);
+            if let Some(e) = failed {
+                job.stale.store(true, Ordering::SeqCst);
+                return Err(e);
+            }
+            if active != 0 {
+                thread::sleep(Duration::from_millis(2));
+            }
+        }
+
+        self.sync_counters(counters);
+        if solution.is_some() {
+            counters.found.fetch_add(1, Ordering::Relaxed);
+        }
+        Ok(solution)
+    }
+}
+
+impl Drop for MultiGpuBackend {
+    fn drop(&mut self) {
+        for w in &self.workers {
+            let _ = w.tx.send(MultiGpuCommand::Stop);
+        }
+        for w in &mut self.workers {
+            if let Some(h) = w.handle.take() {
+                let _ = h.join();
+            }
+        }
     }
 }
 
