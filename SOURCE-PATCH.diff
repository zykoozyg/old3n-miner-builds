+// Experimental exact fusion of gather_gemm and fold_fast. The MMA loop and accumulator mapping are deliberately kept
+// identical to gather_gemm. Instead of writing C to global memory, each block stages its 64 x 128 result tile in the
+// now-dead pipeline shared memory. Its 512 consecutive 16-word chunks then receive the exact global chunk number used
+// by fold_fast, the same ChaCha20 transform and the same eight unsigned 64-bit sums. One atomic per result word and
+// column tile combines the 16 blocks of an attempt; unsigned addition makes their order immaterial.
+// grid = (nb / 128, attempts), 256 threads, G_SMEM bytes of dynamic shared memory. `sums` must be zeroed first.
+__global__ void __launch_bounds__(256) gather_gemm_fold(const unsigned long long x_ptr,
+                                                        const unsigned long long data_ptr,
+                                                        const unsigned long long idx_ptr,
+                                                        const unsigned long long sums_ptr,
+                                                        const unsigned k,
+                                                        const unsigned nb,
+                                                        const unsigned columns,
+                                                        const unsigned idx_stride,
+                                                        const unsigned long long slices_ptr,
+                                                        const unsigned slice_mode)
+{
+    extern __shared__ __align__(16) unsigned char smem[];
+    unsigned char* sx = smem;
+    unsigned char* sw = smem + G_STAGES * G_SX;
+
+    const unsigned a = blockIdx.y;
+    const unsigned n0 = blockIdx.x * G_BN;
+    const unsigned char* X = (const unsigned char*)x_ptr + (unsigned long long)a * 64ull * k;
+    const unsigned char* D = (const unsigned char*)data_ptr;
+    const unsigned* idx = (const unsigned*)idx_ptr + (unsigned long long)a * idx_stride;
+    const unsigned long long slice_first =
+        slice_mode ? (unsigned long long)((const unsigned*)slices_ptr)[a] * nb : 0ull;
+    unsigned long long* sums = (unsigned long long*)sums_ptr + (unsigned long long)a * 8ull;
+
+    const unsigned tid = threadIdx.x;
+    const unsigned pc = (tid & 7u) * 16u;
+    const unsigned char* xsrc[2];
+    const unsigned char* wsrc[4];
+    unsigned xdst[2], wdst[4];
+    #pragma unroll
+    for (int i = 0; i < 2; ++i) {
+        const unsigned row = (tid >> 3) + i * 32;
+        xsrc[i] = X + (unsigned long long)row * k + pc;
+        xdst[i] = row * G_STRIDE + pc;
+    }
+    #pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const unsigned col = (tid >> 3) + i * 32;
+        const unsigned long long column =
+            slice_mode ? slice_first + n0 + col : (unsigned long long)(idx[n0 + col] % columns);
+        wsrc[i] = D + column * k + pc;
+        wdst[i] = col * G_STRIDE + pc;
+    }
+    const unsigned ktiles = k / G_BK;
+
+    const unsigned warp = tid >> 5, lane = tid & 31u;
+    const unsigned wm = (warp & 1u) * 32u;
+    const unsigned wn = (warp >> 1) * 32u;
+    const unsigned g = lane >> 2, t = lane & 3u;
+    const unsigned q = lane >> 3, r8 = lane & 7u;
+    const unsigned a_off = ((q & 1u) * 8u + r8) * G_STRIDE + (q >> 1) * 16u;
+    const unsigned b_off = ((q >> 1) * 8u + r8) * G_STRIDE + (q & 1u) * 16u;
+
+    int acc[2][4][4];
+    #pragma unroll
+    for (int i = 0; i < 2; ++i)
+        #pragma unroll
+        for (int j = 0; j < 4; ++j)
+            #pragma unroll
+            for (int r = 0; r < 4; ++r)
+                acc[i][j][r] = 0;
+
+    #pragma unroll
+    for (unsigned s = 0; s < G_STAGES - 1; ++s) {
+        if (s < ktiles) {
+            const unsigned off = s * G_BK;
+            #pragma unroll
+            for (int i = 0; i < 2; ++i) g_cp_async16(sx + s * G_SX + xdst[i], xsrc[i] + off);
+            #pragma unroll
+            for (int i = 0; i < 4; ++i) g_cp_async16(sw + s * G_SW + wdst[i], wsrc[i] + off);
+        }
+        g_cp_async_commit();
+    }
+
+    for (unsigned kt = 0; kt < ktiles; ++kt) {
+        g_cp_async_wait_one();
+        __syncthreads();
+        const unsigned nk = kt + G_STAGES - 1;
+        if (nk < ktiles) {
+            const unsigned s = nk % G_STAGES;
+            const unsigned off = nk * G_BK;
+            #pragma unroll
+            for (int i = 0; i < 2; ++i) g_cp_async16(sx + s * G_SX + xdst[i], xsrc[i] + off);
+            #pragma unroll
+            for (int i = 0; i < 4; ++i) g_cp_async16(sw + s * G_SW + wdst[i], wsrc[i] + off);
+        }
+        g_cp_async_commit();
+
+        const unsigned char* xs = sx + (kt % G_STAGES) * G_SX;
+        const unsigned char* ws = sw + (kt % G_STAGES) * G_SW;
+        #pragma unroll
+        for (unsigned ks = 0; ks < G_BK; ks += 32) {
+            unsigned af[2][4];
+            unsigned bf[2][4];
+            #pragma unroll
+            for (int i = 0; i < 2; ++i)
+                g_ldmatrix_x4(af[i], xs + (wm + i * 16) * G_STRIDE + ks + a_off);
+            #pragma unroll
+            for (int p = 0; p < 2; ++p)
+                g_ldmatrix_x4(bf[p], ws + (wn + p * 16) * G_STRIDE + ks + b_off);
+            #pragma unroll
+            for (int i = 0; i < 2; ++i)
+                #pragma unroll
+                for (int j = 0; j < 4; ++j)
+                    g_mma(acc[i][j], af[i], bf[j >> 1][(j & 1) * 2], bf[j >> 1][(j & 1) * 2 + 1]);
+        }
+    }
+
+    // No asynchronous copy may still target smem when it is reused for C.
+    g_cp_async_wait_all();
+    __syncthreads();
+    unsigned* c_tile = (unsigned*)smem;
+    #pragma unroll
+    for (int i = 0; i < 2; ++i) {
+        #pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            const unsigned row = wm + i * 16 + g;
+            const unsigned col = wn + j * 8 + t * 2;
+            *(int2*)&c_tile[row * G_BN + col] = make_int2(acc[i][j][0], acc[i][j][1]);
+            *(int2*)&c_tile[(row + 8) * G_BN + col] = make_int2(acc[i][j][2], acc[i][j][3]);
+        }
+    }
+    __syncthreads();
+
+    // There are 512 16-word chunks in a 64 x 128 tile, exactly two per thread.
+    unsigned long long fold_acc[8];
+    #pragma unroll
+    for (int i = 0; i < 8; ++i) fold_acc[i] = 0ull;
+    #pragma unroll
+    for (unsigned local_chunk = tid; local_chunk < 512u; local_chunk += 256u) {
+        unsigned x[16];
+        #pragma unroll
+        for (int i = 0; i < 16; ++i) x[i] = c_tile[local_chunk * 16u + i];
+        const unsigned row = local_chunk >> 3;
+        const unsigned chunk_in_row = local_chunk & 7u;
+        const unsigned global_chunk = row * (nb >> 4) + (n0 >> 4) + chunk_in_row;
+        x[0] ^= global_chunk;
+        gf_chacha_core(x);
+        #pragma unroll
+        for (int i = 0; i < 8; ++i)
+            fold_acc[i] += (unsigned long long)x[i] + (unsigned long long)x[i + 8];
+    }
+
+    // First reduce within each warp, then within the block: eight atomics per C tile rather than 64.
+    // Every warp must finish reading c_tile before its first bytes are reused as warp_sums.
+    __syncthreads();
+    unsigned long long* warp_sums = (unsigned long long*)smem;
+    #pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        unsigned long long v = fold_acc[i];
+        #pragma unroll
+        for (int off = 16; off > 0; off >>= 1) v += __shfl_down_sync(0xffffffffu, v, off);
+        if (lane == 0u) warp_sums[warp * 8u + i] = v;
+    }
+    __syncthreads();
+    if (warp == 0u && lane < 8u) {
+        unsigned long long total = 0ull;
+        #pragma unroll
+        for (int w = 0; w < 8; ++w) total += warp_sums[w * 8 + lane];
+        atomicAdd(&sums[lane], total);
+    }
+}
