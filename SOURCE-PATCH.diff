+// ---- old3n multi-GPU backend --------------------------------------------------------------------------------------------
+// One Miner/RemoteMiner drives this backend, so a remote node sees ONE connection.
+// Every GPU owns its CUDA context on a permanent worker thread.
+
+enum MultiGpuCommand {
+    Mine(Job),
+    Stop,
+}
+
+enum MultiGpuMessage {
+    Ready(String),
+    Solved(Solution),
+    Finished(u64),
+    Failed(String),
+}
+
+struct MultiGpuWorker {
+    tx: Sender<MultiGpuCommand>,
+    rx: Receiver<MultiGpuMessage>,
+    handle: Option<JoinHandle<()>>,
+    counters: Arc<Counters>,
+    last_attempts: u64,
+    last_discarded: u64,
+    last_dataset_builds: u64,
+    last_prefetches: u64,
+    last_build_marks: u64,
+}
+
+pub struct MultiGpuBackend {
+    workers: Vec<MultiGpuWorker>,
+    name: String,
+}
+
+impl MultiGpuBackend {
+    pub fn new(
+        devices: &[(usize, usize)],
+        params: Params,
+        epoch_blocks: u64,
+        gather_from: u64,
+    ) -> Result<MultiGpuBackend, String> {
+        if devices.is_empty() {
+            return Err("multi-GPU needs at least one device".into());
+        }
+        if devices.len() > 256 {
+            return Err("multi-GPU supports at most 256 devices".into());
+        }
+
+        let mut workers = Vec::with_capacity(devices.len());
+        for &(ordinal, batch) in devices {
+            let (cmd_tx, cmd_rx) = channel::<MultiGpuCommand>();
+            let (msg_tx, msg_rx) = channel::<MultiGpuMessage>();
+            let counters = Arc::new(Counters::default());
+            let wc = Arc::clone(&counters);
+
+            let handle = thread::spawn(move || {
+                let mut backend = match GpuBackend::new(ordinal, params, epoch_blocks, batch)
+                    .map(|b| b.gathered_from(gather_from))
+                {
+                    Ok(b) => b,
+                    Err(e) => {
+                        let _ = msg_tx.send(MultiGpuMessage::Failed(format!("GPU {ordinal}: {e}")));
+                        return;
+                    }
+                };
+
+                let _ = msg_tx.send(MultiGpuMessage::Ready(format!(
+                    "GPU {ordinal}: {}",
+                    backend.name()
+                )));
+
+                while let Ok(cmd) = cmd_rx.recv() {
+                    match cmd {
+                        MultiGpuCommand::Mine(job) => {
+                            let id = job.id;
+                            match backend.mine(&job, &wc) {
+                                Ok(Some(sol)) => {
+                                    let _ = msg_tx.send(MultiGpuMessage::Solved(sol));
+                                }
+                                Ok(None) => {}
+                                Err(e) => {
+                                    let _ = msg_tx.send(MultiGpuMessage::Failed(format!(
+                                        "GPU {ordinal}: {e}"
+                                    )));
+                                    return;
+                                }
+                            }
+                            let _ = msg_tx.send(MultiGpuMessage::Finished(id));
+                        }
+                        MultiGpuCommand::Stop => return,
+                    }
+                }
+            });
+
+            workers.push(MultiGpuWorker {
+                tx: cmd_tx,
+                rx: msg_rx,
+                handle: Some(handle),
+                counters,
+                last_attempts: 0,
+                last_discarded: 0,
+                last_dataset_builds: 0,
+                last_prefetches: 0,
+                last_build_marks: 0,
+            });
+        }
+
+        let mut names = Vec::with_capacity(workers.len());
+        for w in &workers {
+            match w.rx.recv_timeout(Duration::from_secs(30)) {
+                Ok(MultiGpuMessage::Ready(name)) => names.push(name),
+                Ok(MultiGpuMessage::Failed(e)) => return Err(e),
+                Ok(_) => return Err("multi-GPU worker sent an unexpected startup message".into()),
+                Err(e) => return Err(format!("multi-GPU worker did not start: {e}")),
+            }
+        }
+
+        Ok(MultiGpuBackend {
+            name: format!("matmulhash on {} GPUs [{}]", names.len(), names.join(" | ")),
+            workers,
+        })
+    }
+
+    fn sync_counters(&mut self, out: &Counters) {
+        for w in &mut self.workers {
+            let now = w.counters.attempts.load(Ordering::Relaxed);
+            out.attempts
+                .fetch_add(now.saturating_sub(w.last_attempts), Ordering::Relaxed);
+            w.last_attempts = now;
+
+            let now = w.counters.discarded.load(Ordering::Relaxed);
+            out.discarded
+                .fetch_add(now.saturating_sub(w.last_discarded), Ordering::Relaxed);
+            w.last_discarded = now;
+
+            let now = w.counters.dataset_builds.load(Ordering::Relaxed);
+            out.dataset_builds
+                .fetch_add(now.saturating_sub(w.last_dataset_builds), Ordering::Relaxed);
+            w.last_dataset_builds = now;
+
+            let now = w.counters.prefetches.load(Ordering::Relaxed);
+            out.prefetches
+                .fetch_add(now.saturating_sub(w.last_prefetches), Ordering::Relaxed);
+            w.last_prefetches = now;
+
+            let now = w.counters.build_marks.load(Ordering::Relaxed);
+            out.build_marks
+                .fetch_add(now.saturating_sub(w.last_build_marks), Ordering::Relaxed);
+            w.last_build_marks = now;
+        }
+    }
+}
