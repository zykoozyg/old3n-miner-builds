+// exactly the same 16-word chunks and chunk numbers as fold_fast, after staging one complete 64 x 128 C tile in shared
+// memory. This avoids writing that tile to global memory and reading it back.
+__device__ __forceinline__ unsigned gf_rotl32(unsigned x, int n) {
+    return (x << n) | (x >> (32 - n));
+}
+
+__device__ __forceinline__ void gf_quarter_round(unsigned &a, unsigned &b, unsigned &c, unsigned &d) {
+    a += b; d ^= a; d = gf_rotl32(d, 16);
+    c += d; b ^= c; b = gf_rotl32(b, 12);
+    a += b; d ^= a; d = gf_rotl32(d, 8);
+    c += d; b ^= c; b = gf_rotl32(b, 7);
+}
+
+__device__ __forceinline__ void gf_chacha_core(unsigned x[16]) {
+    unsigned s[16];
+    #pragma unroll
+    for (int i = 0; i < 16; ++i) s[i] = x[i];
+    #pragma unroll
+    for (int r = 0; r < 10; ++r) {
+        gf_quarter_round(x[0], x[4], x[8],  x[12]);
+        gf_quarter_round(x[1], x[5], x[9],  x[13]);
+        gf_quarter_round(x[2], x[6], x[10], x[14]);
+        gf_quarter_round(x[3], x[7], x[11], x[15]);
+        gf_quarter_round(x[0], x[5], x[10], x[15]);
+        gf_quarter_round(x[1], x[6], x[11], x[12]);
+        gf_quarter_round(x[2], x[7], x[8],  x[13]);
+        gf_quarter_round(x[3], x[4], x[9],  x[14]);
+    }
+    #pragma unroll
+    for (int i = 0; i < 16; ++i) x[i] += s[i];
+}
