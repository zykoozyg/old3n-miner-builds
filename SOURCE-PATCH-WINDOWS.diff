+    /// The caller zeroes `sums` before this launch. Argument and shape requirements otherwise match `launch_multiply`.
+    #[allow(clippy::too_many_arguments)]
+    fn launch_multiply_fold(
+        &self,
+        x: &CudaSlice<u8>,
+        data: &CudaSlice<u8>,
+        idx: &CudaSlice<u8>,
+        slices: Option<&CudaSlice<u32>>,
+        sums: &CudaSlice<u64>,
+        (k, nb, columns): (usize, usize, usize),
+        idx_stride: u32,
+        n: usize,
+    ) -> Result<(), GpuError> {
+        let cfg = LaunchConfig {
+            grid_dim: ((nb / 128) as u32, n as u32, 1),
+            block_dim: (THREADS, 1, 1),
+            shared_mem_bytes: GATHER_SMEM,
+        };
+        let (k, nb, columns) = (k as u32, nb as u32, columns as u32);
+        let slice_mode: u32 = u32::from(slices.is_some());
+        let mut b = self.stream.launch_builder(&self.gather_fold_fn);
+        b.arg(x)
+            .arg(data)
+            .arg(idx)
+            .arg(sums)
+            .arg(&k)
+            .arg(&nb)
+            .arg(&columns)
+            .arg(&idx_stride);
+        match slices {
+            Some(s) => b.arg(s),
+            None => b.arg(idx),
