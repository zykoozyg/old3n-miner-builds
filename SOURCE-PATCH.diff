+    #[allow(clippy::too_many_arguments)]
+    fn launch_multiply_fold(
+        &self,
+        x: &CudaSlice<u8>,
+        data: &CudaSlice<u8>,
+        idx: &CudaSlice<u8>,
+        slices: Option<&CudaSlice<u32>>,
+        sums: &CudaSlice<u64>,
+        (k, nb, columns): (usize, usize, usize),
+        idx_stride: u32,
