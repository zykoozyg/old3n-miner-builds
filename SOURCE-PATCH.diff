+/// Allocates initialized page-locked memory. Initialization matters for a short final batch because cudarc copies the
+/// whole allocation, not only the prefix filled for that batch.
+fn pinned<T: cudarc::driver::DeviceRepr + cudarc::driver::ValidAsZeroBits + Copy + Default>(
+    ctx: &Arc<CudaContext>,
+    len: usize,
+) -> Result<PinnedHostSlice<T>, GpuError> {
+    // SAFETY: every element is initialized immediately, before CUDA or Rust reads the allocation.
+    #[allow(unsafe_code)]
+    let mut out = unsafe { ctx.alloc_pinned_with_flags::<T>(len, 0)? };
+    out.as_mut_slice()?.fill(T::default());
+    Ok(out)
+}
